<view class="container">
  <!-- 顶部导航 -->
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="page-title">图书馆公告</text>
    <view class="placeholder"></view>
  </view>

  <!-- 公告列表 -->
  <scroll-view class="announcement-list" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="announcement-item" 
          wx:for="{{announcements}}" 
          wx:key="id"
          bindtap="navigateToDetail"
          data-id="{{item.id}}">
      <view class="announcement-header">
        <text class="announcement-title">{{item.title}}</text>
        <view class="announcement-badge" wx:if="{{index < 3}}">最新</view>
      </view>
      <view class="announcement-meta">
        <text class="meta-item">
          <text class="meta-icon">📅</text>
          <text class="meta-text">{{item.formattedDate}}</text>
        </text>
        <text class="meta-item" wx:if="{{item.author}}">
          <text class="meta-icon">👤</text>
          <text class="meta-text">{{item.author}}</text>
        </text>
      </view>
      <view class="announcement-content">
        <text class="content-text">{{item.briefContent}}</text>
      </view>
      <view class="announcement-footer">
        <text class="view-detail">查看详情 →</text>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-more" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 无更多数据 -->
    <view class="no-more" wx:if="{{!hasMore && announcements.length > 0}}">
      <text class="no-more-text">没有更多公告了</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && announcements.length === 0}}">
      <view class="empty-icon">📢</view>
      <text class="empty-title">暂无公告</text>
      <text class="empty-desc">图书馆暂时没有发布新公告</text>
    </view>
  </scroll-view>
</view>
