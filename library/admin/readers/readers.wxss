.readers-container {
  display: flex;
  min-height: 100vh;
  background: #f5f7fa;
}

/* 侧边栏 */
.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  width: 240rpx;
  height: 100vh;
  background: #fff;
  box-shadow: 2rpx 0 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
  transform: translateX(-100%);
  transition: transform 0.3s ease;
}

.sidebar.open {
  transform: translateX(0);
}

.sidebar-header {
  padding: 40rpx 30rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.admin-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.admin-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.sidebar-menu {
  padding: 20rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  cursor: pointer;
  transition: all 0.3s;
}

.menu-item.active {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.menu-item.active .menu-icon,
.menu-item.active .menu-text {
  color: #fff;
}

.menu-item.logout {
  margin-top: 40rpx;
  border-top: 1rpx solid #eee;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #666;
}

/* 遮罩层 */
.sidebar-overlay {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.sidebar-overlay.show {
  opacity: 1;
  visibility: visible;
}

/* 主内容区 */
.main-content {
  flex: 1;
  width: 100%;
}

/* 顶部导航 */
.top-nav {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 10;
}

.menu-toggle {
  padding: 10rpx;
  margin-right: 20rpx;
}

.toggle-icon {
  font-size: 40rpx;
  color: #667eea;
}

.page-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.nav-right {
  display: flex;
  align-items: center;
}

.export-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  border: none;
}

.export-btn::after {
  border: none;
}

/* 读者列表 */
.readers-list {
  height: calc(100vh - 100rpx);
  padding: 20rpx;
}

.reader-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.reader-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

.reader-info {
  flex: 1;
}

.reader-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.reader-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.reader-id {
  font-size: 24rpx;
  color: #999;
  background: #f5f7fa;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.reader-stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  font-size: 24rpx;
  color: #666;
}

.stat-item.overdue {
  color: #f44336;
  font-weight: 500;
}

.reader-arrow {
  padding: 10rpx;
}

.arrow-icon {
  font-size: 40rpx;
  color: #ccc;
}

/* 加载状态 */
.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}

/* 弹窗 */
.modal {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 90%;
  max-height: 85%;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  z-index: 201;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  padding: 0 10rpx;
}

.modal-body {
  max-height: 800rpx;
  padding: 30rpx;
}

/* 详情头部 */
.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.detail-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.detail-avatar .avatar-text {
  font-size: 48rpx;
}

.detail-basic {
  flex: 1;
}

.detail-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.detail-id, .detail-class {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

/* 详情统计 */
.detail-stats {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  margin-bottom: 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-box .stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 8rpx;
}

.stat-box .stat-num.overdue {
  color: #f44336;
}

.stat-box .stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 借阅列表 */
.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.borrow-list {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx;
}

.borrow-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #667eea;
}

.borrow-item.returned {
  border-left-color: #4caf50;
}

.borrow-item:last-child {
  margin-bottom: 0;
}

.borrow-book {
  margin-bottom: 12rpx;
}

.book-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.book-author {
  font-size: 24rpx;
  color: #999;
}

.borrow-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.borrow-date, .due-date, .return-date {
  font-size: 24rpx;
  color: #666;
}

.due-date.overdue {
  color: #f44336;
  font-weight: 500;
}

.empty-borrow {
  text-align: center;
  padding: 60rpx 40rpx;
}

.empty-borrow .empty-text {
  font-size: 28rpx;
  color: #999;
}
