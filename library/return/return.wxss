.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 顶部标题栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 36rpx;
  color: #fff;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.placeholder {
  width: 60rpx;
}

/* 表单区域 */
.form-section {
  padding: 30rpx;
}

.form-card {
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.form-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.form-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-color);
}

.form-body {
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #ff4d4f;
  margin-right: 8rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-color);
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--primary-color);
}

.form-footer {
  display: flex;
  justify-content: center;
}

.submit-btn {
  width: 80%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

/* 还书须知 */
.notice-card {
  padding: 30rpx;
}

.notice-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.notice-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.notice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary-color);
  margin-right: 16rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.notice-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 结果区域 */
.result-section {
  padding: 30rpx;
}

.result-card {
  padding: 60rpx 40rpx;
}

.result-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.result-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #fff;
  margin-bottom: 30rpx;
}

.result-icon.success {
  background: #52c41a;
}

.result-icon.error {
  background: #ff4d4f;
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.result-message {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 30rpx;
}

/* 逾期提醒 */
.overdue-warning {
  width: 100%;
  background: #fff2f0;
  border: 2rpx solid #ffccc7;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: flex-start;
}

.warning-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.warning-content {
  flex: 1;
}

.warning-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #ff4d4f;
  margin-bottom: 12rpx;
}

.warning-text {
  display: block;
  font-size: 26rpx;
  color: #ff7875;
  margin-bottom: 8rpx;
}

/* 图书信息 */
.book-info {
  width: 100%;
  background: #f8f9ff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 20rpx;
}

.info-item {
  display: flex;
  margin-bottom: 16rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  width: 160rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: var(--text-color);
  font-weight: 500;
  flex: 1;
}

.info-value.highlight {
  color: #52c41a;
  font-weight: 600;
}

.info-value.overdue {
  color: #ff4d4f;
  font-weight: 600;
}

/* 结果操作按钮 */
.result-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  color: #fff;
}

.action-btn.secondary {
  background: #f0f0f0;
  color: var(--text-color);
}
