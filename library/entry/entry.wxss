.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 图书馆头部 */
.library-header {
  padding: 20rpx;
}

.library-bg {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  color: #fff;
}

.library-name {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.library-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.open-time {
  font-size: 26rpx;
  opacity: 0.9;
}

.status {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status.open {
  background: rgba(82, 196, 26, 0.9);
}

.status.closed {
  background: rgba(245, 34, 45, 0.9);
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 40rpx 20rpx;
  margin: 0 20rpx 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #e0e0e0;
}

/* 入口选择 */
.entry-section {
  padding: 20rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, var(--primary-color) 0%, var(--secondary-color) 100%);
  border-radius: 3rpx;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.entry-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 50rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.entry-card.student {
  border-top: 6rpx solid #667eea;
}

.entry-card.admin {
  border-top: 6rpx solid #764ba2;
}

.entry-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f8f9ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.icon-text {
  font-size: 60rpx;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.entry-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* 快捷功能 */
.quick-actions {
  margin: 20rpx;
  padding: 30rpx;
}

.action-list {
  margin-top: 20rpx;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.action-item:last-child {
  border-bottom: none;
}

.action-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.action-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-color);
}

.action-arrow {
  font-size: 28rpx;
  color: #999;
}

/* 返回主系统 */
.back-section {
  margin: 40rpx 20rpx;
  display: flex;
  justify-content: center;
}

.back-link {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.back-icon {
  font-size: 32rpx;
  color: var(--primary-color);
  margin-right: 12rpx;
}

.back-text {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
}
