.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 头部搜索区域 */
.header-section {
  position: relative;
  height: 180rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 40rpx 30rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: #999;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-input::placeholder {
  color: #999;
}

.clear-btn {
  padding: 8rpx;
  margin-left: 16rpx;
}

.clear-btn text {
  font-size: 24rpx;
  color: #999;
}

/* 类型筛选 */
.filter-section {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.type-scroll {
  white-space: nowrap;
}

.type-list {
  display: flex;
  padding: 0 20rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: #f5f7fa;
  transition: all 0.3s;
}

.type-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.type-item.active .type-icon,
.type-item.active .type-name {
  color: #fff;
}

.type-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.type-name {
  font-size: 24rpx;
  color: #666;
}

/* 资源列表 */
.resources-section {
  padding: 0 30rpx;
}

.resources-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.resource-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.resource-card:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.resource-icon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.resource-icon text {
  font-size: 48rpx;
}

.resource-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.resource-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.resource-meta {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.meta-item.type-document {
  background: #e3f2fd;
  color: #1976d2;
}

.meta-item.type-video {
  background: #fce4ec;
  color: #c2185b;
}

.meta-item.type-audio {
  background: #f3e5f5;
  color: #7b1fa2;
}

.meta-item.type-image {
  background: #e8f5e9;
  color: #388e3c;
}

.resource-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.uploader {
  display: flex;
  align-items: center;
}

.uploader-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.uploader-name {
  font-size: 24rpx;
  color: #666;
}

.download-info {
  display: flex;
  align-items: center;
}

.download-icon {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.download-count {
  font-size: 24rpx;
  color: #667eea;
  font-weight: bold;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: #999;
}

/* 加载更多 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 16rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 40rpx;
}

.no-more text {
  font-size: 24rpx;
  color: #999;
}
