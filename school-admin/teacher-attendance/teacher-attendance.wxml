<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">教师考勤管理</text>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-section">
    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-value">{{stats.total}}</text>
        <text class="stat-label">总人数</text>
      </view>
      <view class="stat-item present">
        <text class="stat-value">{{stats.present}}</text>
        <text class="stat-label">正常</text>
      </view>
      <view class="stat-item absent">
        <text class="stat-value">{{stats.absent}}</text>
        <text class="stat-label">缺勤</text>
      </view>
      <view class="stat-item late">
        <text class="stat-value">{{stats.late}}</text>
        <text class="stat-label">迟到</text>
      </view>
      <view class="stat-item leave">
        <text class="stat-value">{{stats.leave}}</text>
        <text class="stat-label">请假</text>
      </view>
    </view>
  </view>

  <!-- 筛选区域 -->
  <view class="filter-section">
    <view class="filter-row">
      <view class="filter-item">
        <text class="filter-label">日期</text>
        <picker mode="date" value="{{currentDate}}" bindchange="onDateChange">
          <view class="picker-value">{{currentDate}}</view>
        </picker>
      </view>
      <view class="filter-item">
        <text class="filter-label">状态</text>
        <view class="filter-options">
          <view class="filter-option {{selectedStatus === '' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="">全部</view>
          <view class="filter-option {{selectedStatus === 'present' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="present">正常</view>
          <view class="filter-option {{selectedStatus === 'absent' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="absent">缺勤</view>
          <view class="filter-option {{selectedStatus === 'late' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="late">迟到</view>
          <view class="filter-option {{selectedStatus === 'leave' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="leave">请假</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 考勤列表 -->
  <view class="attendance-list">
    <view class="list-header">
      <text class="header-title">考勤记录</text>
      <text class="header-count">共 {{filteredRecords.length}} 条</text>
    </view>

    <block wx:if="{{filteredRecords.length > 0}}">
      <view class="attendance-card" wx:for="{{filteredRecords}}" wx:key="id" bindtap="showDetail" data-record="{{item}}">
        <view class="card-header">
          <view class="teacher-info">
            <text class="teacher-name">{{item.teacherName}}</text>
            <text class="teacher-dept">{{item.department}}</text>
          </view>
          <view class="status-badge {{getStatusClass(item.status)}}">
            {{getStatusText(item.status)}}
          </view>
        </view>
        <view class="card-body">
          <view class="info-row">
            <text class="info-label">打卡时间</text>
            <text class="info-value">{{item.checkTime || '未打卡'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">备注</text>
            <text class="info-value">{{item.remark || '无'}}</text>
          </view>
        </view>
        <view class="card-actions">
          <view class="action-btn present" bindtap="markAttendance" data-id="{{item.id}}" data-status="present">正常</view>
          <view class="action-btn late" bindtap="markAttendance" data-id="{{item.id}}" data-status="late">迟到</view>
          <view class="action-btn absent" bindtap="markAttendance" data-id="{{item.id}}" data-status="absent">缺勤</view>
          <view class="action-btn leave" bindtap="markAttendance" data-id="{{item.id}}" data-status="leave">请假</view>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:else>
      <text class="empty-text">暂无考勤记录</text>
    </view>
  </view>

  <!-- 详情弹窗 -->
  <view class="modal-overlay" wx:if="{{showDetailModal}}" bindtap="closeDetail">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">考勤详情</text>
        <view class="close-btn" bindtap="closeDetail">×</view>
      </view>
      <view class="modal-body" wx:if="{{currentRecord}}">
        <view class="detail-row">
          <text class="detail-label">教师姓名</text>
          <text class="detail-value">{{currentRecord.teacherName}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">所属部门</text>
          <text class="detail-value">{{currentRecord.department}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">考勤状态</text>
          <view class="status-badge {{getStatusClass(currentRecord.status)}}">
            {{getStatusText(currentRecord.status)}}
          </view>
        </view>
        <view class="detail-row">
          <text class="detail-label">打卡时间</text>
          <text class="detail-value">{{currentRecord.checkTime || '未打卡'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">备注信息</text>
          <text class="detail-value">{{currentRecord.remark || '无'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
