<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <text class="title">教师管理</text>
    <view class="add-btn" bindtap="showAddModal">
      <text class="add-icon">+</text>
      <text>添加教师</text>
    </view>
  </view>

  <!-- 教师列表 -->
  <view class="teacher-list">
    <block wx:if="{{teachers.length > 0}}">
      <view class="teacher-card" wx:for="{{teachers}}" wx:key="id">
        <view class="teacher-info">
          <view class="info-row">
            <text class="teacher-name">{{item.name}}</text>
            <text class="teacher-title">{{item.title}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">科目：</text>
            <text class="info-value">{{item.subject}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">电话：</text>
            <text class="info-value">{{item.phone}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">部门：</text>
            <text class="info-value">{{item.department}}</text>
          </view>
        </view>
        <view class="teacher-actions">
          <view class="action-btn edit-btn" bindtap="showEditModal" data-id="{{item.id}}">
            <text>编辑</text>
          </view>
          <view class="action-btn delete-btn" bindtap="showDeleteConfirm" data-id="{{item.id}}" data-name="{{item.name}}">
            <text>删除</text>
          </view>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:else>
      <text class="empty-text">暂无教师数据</text>
    </view>
  </view>

  <!-- 添加/编辑教师弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="hideModal"></view>
  <view class="modal {{showModal ? 'modal-show' : ''}}">
    <view class="modal-header">
      <text class="modal-title">{{isEdit ? '编辑教师' : '添加教师'}}</text>
      <view class="modal-close" bindtap="hideModal">
        <text>×</text>
      </view>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">姓名</text>
        <input class="form-input" type="text" placeholder="请输入教师姓名" value="{{formData.name}}" bindinput="onNameInput" />
      </view>
      <view class="form-item">
        <text class="form-label">性别</text>
        <radio-group class="radio-group" bindchange="onGenderChange">
          <label class="radio-label">
            <radio value="男" checked="{{formData.gender === '男'}}" />
            <text>男</text>
          </label>
          <label class="radio-label">
            <radio value="女" checked="{{formData.gender === '女'}}" />
            <text>女</text>
          </label>
        </radio-group>
      </view>
      <view class="form-item">
        <text class="form-label">科目</text>
        <input class="form-input" type="text" placeholder="请输入教学科目" value="{{formData.subject}}" bindinput="onSubjectInput" />
      </view>
      <view class="form-item">
        <text class="form-label">职称</text>
        <picker class="form-picker" mode="selector" range="{{titleOptions}}" value="{{titleIndex}}" bindchange="onTitleChange">
          <view class="picker-value">{{formData.title || '请选择职称'}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">电话</text>
        <input class="form-input" type="number" placeholder="请输入联系电话" value="{{formData.phone}}" bindinput="onPhoneInput" />
      </view>
      <view class="form-item">
        <text class="form-label">邮箱</text>
        <input class="form-input" type="text" placeholder="请输入邮箱地址" value="{{formData.email}}" bindinput="onEmailInput" />
      </view>
      <view class="form-item">
        <text class="form-label">部门</text>
        <input class="form-input" type="text" placeholder="请输入所属部门" value="{{formData.department}}" bindinput="onDepartmentInput" />
      </view>
    </view>
    <view class="modal-footer">
      <view class="btn btn-cancel" bindtap="hideModal">
        <text>取消</text>
      </view>
      <view class="btn btn-confirm" bindtap="saveTeacher">
        <text>保存</text>
      </view>
    </view>
  </view>

  <!-- 删除确认弹窗 -->
  <view class="modal-mask" wx:if="{{showDeleteModal}}" bindtap="hideDeleteModal"></view>
  <view class="modal delete-modal {{showDeleteModal ? 'modal-show' : ''}}">
    <view class="modal-header">
      <text class="modal-title">确认删除</text>
    </view>
    <view class="modal-body">
      <text class="confirm-text">确定要删除教师 "{{deleteTeacherName}}" 吗？</text>
      <text class="confirm-tip">此操作不可恢复</text>
    </view>
    <view class="modal-footer">
      <view class="btn btn-cancel" bindtap="hideDeleteModal">
        <text>取消</text>
      </view>
      <view class="btn btn-delete" bindtap="deleteTeacher">
        <text>删除</text>
      </view>
    </view>
  </view>
</view>
