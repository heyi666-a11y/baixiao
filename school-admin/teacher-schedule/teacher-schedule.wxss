.container {
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

.page-header {
  text-align: center;
  padding: 30rpx 0;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

/* 教师选择器 */
.teacher-selector {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.selector-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-right: 20rpx;
}

.picker-value {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: #667eea;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

/* 课表容器 */
.schedule-container {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.schedule-header {
  display: flex;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header-cell {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.header-cell.time-cell {
  width: 120rpx;
  flex: none;
}

/* 课表主体 */
.schedule-body {
  background: #fff;
}

.schedule-row {
  display: flex;
  border-bottom: 2rpx solid #f0f0f0;
}

.schedule-row:last-child {
  border-bottom: none;
}

.time-cell {
  width: 120rpx;
  flex: none;
  background: #f8f9fa;
  padding: 20rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 2rpx solid #f0f0f0;
}

.period-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.period-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.schedule-cell {
  flex: 1;
  min-height: 120rpx;
  padding: 16rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 2rpx solid #f0f0f0;
  transition: all 0.3s;
}

.schedule-cell:last-child {
  border-right: none;
}

.schedule-cell.has-class {
  background: linear-gradient(135deg, #e8f4fd 0%, #f0f9ff 100%);
}

.schedule-cell:active {
  background: #f0f0f0;
}

.subject-name {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 600;
  text-align: center;
}

.class-info {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
  text-align: center;
}

.room-info {
  font-size: 18rpx;
  color: #999;
  margin-top: 2rpx;
  text-align: center;
}

.empty-slot {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

/* 空状态 */
.empty-state {
  background: #fff;
  border-radius: 16rpx;
  padding: 100rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 16rpx;
  width: 85%;
  max-width: 600rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.close-btn {
  font-size: 48rpx;
  color: #fff;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.form-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  padding: 16rpx 0;
}

.form-input {
  font-size: 30rpx;
  color: #333;
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.form-input:focus {
  border-color: #667eea;
  background: #fff;
}

.modal-footer {
  display: flex;
  padding: 20rpx 30rpx 30rpx;
  gap: 20rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-secondary {
  background: #f5f5f5;
  color: #666;
}

.btn-danger {
  background: #fff2f0;
  color: #ff4d4f;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}
