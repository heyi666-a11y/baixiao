<view class="publish-container">
  <!-- 头部 -->
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="back-btn" bindtap="goBack">
        <text class="back-icon">‹</text>
      </view>
      <text class="header-title">{{isEdit ? '编辑新闻' : '发布新闻'}}</text>
      <view class="header-right"></view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 表单 -->
  <view class="form-section" wx:if="{{!loading}}">
    <!-- 标题 -->
    <view class="form-item">
      <text class="form-label required">标题</text>
      <input 
        class="form-input" 
        placeholder="请输入新闻标题"
        value="{{form.title}}"
        bindinput="onTitleInput"
      />
    </view>

    <!-- 作者 -->
    <view class="form-item">
      <text class="form-label required">作者</text>
      <input 
        class="form-input" 
        placeholder="请输入作者名称"
        value="{{form.author}}"
        bindinput="onAuthorInput"
      />
    </view>

    <!-- 分类 -->
    <view class="form-item">
      <text class="form-label">分类</text>
      <view class="category-list">
        <view 
          class="category-item {{form.category === item.id ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          data-category="{{item.id}}"
          bindtap="onCategoryChange"
        >
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 摘要 -->
    <view class="form-item">
      <text class="form-label">摘要</text>
      <textarea 
        class="form-textarea summary-textarea"
        placeholder="请输入新闻摘要（选填，不填将自动提取正文前100字）"
        value="{{form.summary}}"
        bindinput="onSummaryInput"
        maxlength="200"
      />
      <text class="input-hint">{{form.summary.length}}/200</text>
    </view>

    <!-- 内容 -->
    <view class="form-item">
      <text class="form-label required">正文内容</text>
      <textarea 
        class="form-textarea content-textarea"
        placeholder="请输入新闻正文内容..."
        value="{{form.content}}"
        bindinput="onContentInput"
      />
    </view>

    <!-- 设置 -->
    <view class="form-item settings-item">
      <text class="form-label">设置</text>
      <view class="settings-list">
        <!-- 置顶 -->
        <view class="setting-item">
          <view class="setting-info">
            <text class="setting-name">置顶显示</text>
            <text class="setting-desc">置顶的新闻将显示在列表最前面</text>
          </view>
          <switch 
            class="setting-switch" 
            checked="{{form.isTop}}"
            bindchange="onTopChange"
            color="#667eea"
          />
        </view>

        <!-- 发布状态 -->
        <view class="setting-item">
          <view class="setting-info">
            <text class="setting-name">立即发布</text>
            <text class="setting-desc">关闭后保存为草稿，不会立即显示</text>
          </view>
          <switch 
            class="setting-switch" 
            checked="{{form.isPublished}}"
            bindchange="onPublishChange"
            color="#667eea"
          />
        </view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer-section">
    <view class="btn-group">
      <view class="btn btn-cancel" bindtap="goBack">取消</view>
      <view class="btn btn-submit {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">
        <text wx:if="{{!submitting}}">{{isEdit ? '保存修改' : '发布新闻'}}</text>
        <text wx:else>提交中...</text>
      </view>
    </view>
  </view>
</view>
