<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <text class="title">学生管理</text>
    <view class="add-btn" bindtap="showAddModal">
      <text class="add-icon">+</text>
      <text>添加学生</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <input 
      type="text" 
      placeholder="搜索姓名、学号或班级" 
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
    <text class="search-icon">🔍</text>
  </view>

  <!-- 统计信息 -->
  <view class="stats-bar">
    <text class="stats-text">共 {{filteredStudents.length}} 名学生</text>
  </view>

  <!-- 学生列表 -->
  <view class="student-list">
    <block wx:if="{{filteredStudents.length > 0}}">
      <view 
        class="student-card" 
        wx:for="{{filteredStudents}}" 
        wx:key="id"
      >
        <view class="student-info" bindtap="viewStudentDetail" data-id="{{item.id}}">
          <view class="student-header">
            <text class="student-name">{{item.name}}</text>
            <view class="gender-tag {{item.gender === '男' ? 'male' : 'female'}}">{{item.gender}}</view>
          </view>
          <view class="student-detail">
            <text class="detail-text">学号：{{item.student_id}}</text>
            <text class="detail-text">班级：{{item.class_name}}</text>
          </view>
        </view>
        <view class="student-actions">
          <view class="action-btn edit" bindtap="showEditModal" data-id="{{item.id}}">编辑</view>
          <view class="action-btn delete" bindtap="deleteStudent" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </block>
    
    <!-- 空状态 -->
    <view wx:else class="empty-state">
      <text class="empty-icon">👨‍🎓</text>
      <text class="empty-text">暂无学生数据</text>
    </view>
  </view>

  <!-- 添加/编辑弹窗 -->
  <view class="modal {{showModal ? 'show' : ''}}" bindtap="hideModal">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">{{isEdit ? '编辑学生' : '添加学生'}}</text>
        <text class="close-btn" bindtap="hideModal">×</text>
      </view>
      
      <scroll-view class="modal-body" scroll-y>
        <view class="form-item">
          <text class="form-label">姓名 *</text>
          <input type="text" placeholder="请输入姓名" value="{{formData.name}}" data-field="name" bindinput="onFormInput"/>
        </view>
        
        <view class="form-item">
          <text class="form-label">学号 *</text>
          <input type="text" placeholder="请输入学号" value="{{formData.student_id}}" data-field="student_id" bindinput="onFormInput"/>
        </view>
        
        <view class="form-item">
          <text class="form-label">班级 *</text>
          <input type="text" placeholder="请输入班级" value="{{formData.class_name}}" data-field="class_name" bindinput="onFormInput"/>
        </view>
        
        <view class="form-item">
          <text class="form-label">性别</text>
          <view class="gender-select">
            <view class="gender-option {{formData.gender === '男' ? 'active' : ''}}" data-gender="男" bindtap="onGenderChange">男</view>
            <view class="gender-option {{formData.gender === '女' ? 'active' : ''}}" data-gender="女" bindtap="onGenderChange">女</view>
          </view>
        </view>
        
        <view class="form-item">
          <text class="form-label">联系电话</text>
          <input type="text" placeholder="请输入联系电话" value="{{formData.phone}}" data-field="phone" bindinput="onFormInput"/>
        </view>
        
        <view class="form-item">
          <text class="form-label">邮箱</text>
          <input type="text" placeholder="请输入邮箱" value="{{formData.email}}" data-field="email" bindinput="onFormInput"/>
        </view>
        
        <view class="form-item">
          <text class="form-label">出生日期</text>
          <picker mode="date" value="{{formData.birthday}}" data-field="birthday" bindchange="onDateChange">
            <view class="picker-value">{{formData.birthday || '请选择日期'}}</view>
          </picker>
        </view>
        
        <view class="form-item">
          <text class="form-label">入学日期</text>
          <picker mode="date" value="{{formData.enrollment_date}}" data-field="enrollment_date" bindchange="onDateChange">
            <view class="picker-value">{{formData.enrollment_date || '请选择日期'}}</view>
          </picker>
        </view>
      </scroll-view>
      
      <view class="modal-footer">
        <view class="btn btn-cancel" bindtap="hideModal">取消</view>
        <view class="btn btn-confirm" bindtap="saveStudent">保存</view>
      </view>
    </view>
  </view>
</view>
