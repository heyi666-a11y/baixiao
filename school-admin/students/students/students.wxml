<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <text class="title">学生管理</text>
    <view class="add-btn" bindtap="showAddModal">
      <text class="add-icon">+</text>
      <text>添加学生</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <input 
      type="text" 
      placeholder="搜索姓名或学号" 
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <view class="search-icon" bindtap="onSearch">🔍</view>
  </view>

  <!-- 统计信息 -->
  <view class="stats-bar">
    <text>共 {{filteredStudents.length}} 名学生</text>
  </view>

  <!-- 学生列表 -->
  <view class="student-list">
    <block wx:if="{{filteredStudents.length > 0}}">
      <view 
        class="student-card" 
        wx:for="{{filteredStudents}}" 
        wx:key="id"
      >
        <view class="student-info">
          <view class="student-header">
            <text class="student-name">{{item.name}}</text>
            <text class="student-gender {{item.gender === '男' ? 'male' : 'female'}}">{{item.gender}}</text>
          </view>
          <view class="student-details">
            <view class="detail-item">
              <text class="label">学号：</text>
              <text class="value">{{item.student_id}}</text>
            </view>
            <view class="detail-item">
              <text class="label">班级：</text>
              <text class="value">{{item.class_name}}</text>
            </view>
          </view>
        </view>
        <view class="student-actions">
          <view class="action-btn edit-btn" bindtap="showEditModal" data-id="{{item.id}}">
            <text>编辑</text>
          </view>
          <view class="action-btn delete-btn" bindtap="showDeleteConfirm" data-id="{{item.id}}">
            <text>删除</text>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="empty-state">
      <text class="empty-icon">📚</text>
      <text class="empty-text">暂无学生数据</text>
    </view>
  </view>

  <!-- 添加/编辑学生弹窗 -->
  <view class="modal {{showModal ? 'show' : ''}}" bindtap="hideModal">
    <view class="modal-content" catchtap="preventHide">
      <view class="modal-header">
        <text class="modal-title">{{isEdit ? '编辑学生' : '添加学生'}}</text>
        <view class="close-btn" bindtap="hideModal">×</view>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">姓名 <text class="required">*</text></text>
          <input 
            type="text" 
            placeholder="请输入姓名" 
            value="{{formData.name}}"
            data-field="name"
            bindinput="onFormInput"
          />
        </view>
        <view class="form-item">
          <text class="form-label">学号 <text class="required">*</text></text>
          <input 
            type="text" 
            placeholder="请输入学号" 
            value="{{formData.student_id}}"
            data-field="student_id"
            bindinput="onFormInput"
          />
        </view>
        <view class="form-item">
          <text class="form-label">班级 <text class="required">*</text></text>
          <input 
            type="text" 
            placeholder="请输入班级" 
            value="{{formData.class_name}}"
            data-field="class_name"
            bindinput="onFormInput"
          />
        </view>
        <view class="form-item">
          <text class="form-label">性别 <text class="required">*</text></text>
          <view class="gender-select">
            <view 
              class="gender-option {{formData.gender === '男' ? 'selected' : ''}}"
              data-gender="男"
              bindtap="onGenderSelect"
            >男</view>
            <view 
              class="gender-option {{formData.gender === '女' ? 'selected' : ''}}"
              data-gender="女"
              bindtap="onGenderSelect"
            >女</view>
          </view>
        </view>
        <view class="form-item">
          <text class="form-label">联系电话</text>
          <input 
            type="text" 
            placeholder="请输入联系电话" 
            value="{{formData.phone}}"
            data-field="phone"
            bindinput="onFormInput"
          />
        </view>
        <view class="form-item">
          <text class="form-label">邮箱</text>
          <input 
            type="text" 
            placeholder="请输入邮箱" 
            value="{{formData.email}}"
            data-field="email"
            bindinput="onFormInput"
          />
        </view>
        <view class="form-item">
          <text class="form-label">地址</text>
          <input 
            type="text" 
            placeholder="请输入地址" 
            value="{{formData.address}}"
            data-field="address"
            bindinput="onFormInput"
          />
        </view>
        <view class="form-item">
          <text class="form-label">出生日期</text>
          <picker mode="date" value="{{formData.birthday}}" bindchange="onBirthdayChange">
            <view class="picker-value">{{formData.birthday || '请选择出生日期'}}</view>
          </picker>
        </view>
        <view class="form-item">
          <text class="form-label">入学日期</text>
          <picker mode="date" value="{{formData.enrollment_date}}" bindchange="onEnrollmentChange">
            <view class="picker-value">{{formData.enrollment_date || '请选择入学日期'}}</view>
          </picker>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn btn-cancel" bindtap="hideModal">取消</view>
        <view class="btn btn-confirm" bindtap="saveStudent">保存</view>
      </view>
    </view>
  </view>

  <!-- 删除确认弹窗 -->
  <view class="modal {{showDeleteModal ? 'show' : ''}}" bindtap="hideDeleteModal">
    <view class="modal-content delete-content" catchtap="preventHide">
      <view class="modal-header">
        <text class="modal-title">确认删除</text>
      </view>
      <view class="modal-body">
        <text class="delete-text">确定要删除学生 "{{deleteStudentName}}" 吗？</text>
        <text class="delete-warning">此操作不可恢复！</text>
      </view>
      <view class="modal-footer">
        <view class="btn btn-cancel" bindtap="hideDeleteModal">取消</view>
        <view class="btn btn-delete" bindtap="confirmDelete">删除</view>
      </view>
    </view>
  </view>
</view>
