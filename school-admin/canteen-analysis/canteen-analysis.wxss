.container {
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

.page-header {
  text-align: center;
  padding: 30rpx 0;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

/* 日期选择 */
.date-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.date-picker {
  flex: 1;
}

.date-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  display: block;
}

.date-value {
  font-size: 28rpx;
  color: #667eea;
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
}

.date-separator {
  font-size: 28rpx;
  color: #999;
  padding: 0 20rpx;
}

/* 区块标题 */
.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

/* 热销TOP3 */
.top-section {
  margin-bottom: 20rpx;
}

.top-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.top-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.top-item:last-child {
  border-bottom: none;
}

.top-item.first {
  background: linear-gradient(90deg, #fff9e6 0%, #fff 100%);
  margin: 0 -24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
}

.rank-badge {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.dish-info {
  flex: 1;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.dish-count {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.dish-revenue {
  font-size: 32rpx;
  font-weight: bold;
  color: #52c41a;
}

/* 餐次分析 */
.meal-section {
  margin-bottom: 20rpx;
}

.meal-list {
  display: flex;
  gap: 20rpx;
}

.meal-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.meal-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.meal-stats {
  display: flex;
  justify-content: space-around;
}

.meal-stat {
  text-align: center;
}

.meal-stat .stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  display: block;
}

.meal-stat .stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

/* 菜品排行 */
.dish-section {
  margin-bottom: 20rpx;
}

.dish-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.dish-header {
  display: flex;
  background: #f8f9fa;
  padding: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.header-cell {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  text-align: center;
}

.header-cell.rank {
  width: 80rpx;
}

.header-cell.name {
  flex: 1;
  text-align: left;
  padding-left: 20rpx;
}

.header-cell.count {
  width: 120rpx;
}

.header-cell.revenue {
  width: 150rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 2rpx solid #f8f8f8;
}

.dish-item:last-child {
  border-bottom: none;
}

.item-cell {
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.item-cell.rank {
  width: 80rpx;
  font-weight: bold;
  color: #999;
}

.item-cell.rank.top {
  color: #667eea;
}

.item-cell.name {
  flex: 1;
  text-align: left;
  padding-left: 20rpx;
}

.item-cell.count {
  width: 120rpx;
  color: #667eea;
}

.item-cell.revenue {
  width: 150rpx;
  color: #52c41a;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
