<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">菜品分析</text>
  </view>

  <!-- 日期选择 -->
  <view class="date-section">
    <view class="date-picker">
      <text class="date-label">开始</text>
      <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
        <view class="date-value">{{startDate}}</view>
      </picker>
    </view>
    <text class="date-separator">至</text>
    <view class="date-picker">
      <text class="date-label">结束</text>
      <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
        <view class="date-value">{{endDate}}</view>
      </picker>
    </view>
  </view>

  <!-- 热销菜品TOP3 -->
  <view class="top-section" wx:if="{{getTopThreeDishes().length > 0}}">
    <view class="section-header">
      <text class="section-title">热销菜品 TOP3</text>
    </view>
    <view class="top-list">
      <view class="top-item {{index === 0 ? 'first' : ''}}" wx:for="{{getTopThreeDishes()}}" wx:key="name">
        <view class="rank-badge">{{index + 1}}</view>
        <view class="dish-info">
          <text class="dish-name">{{item.name}}</text>
          <text class="dish-count">销量 {{item.count}} 份</text>
        </view>
        <text class="dish-revenue">¥{{item.revenue.toFixed(2)}}</text>
      </view>
    </view>
  </view>

  <!-- 餐次分析 -->
  <view class="meal-section" wx:if="{{mealTypeStats.length > 0}}">
    <view class="section-header">
      <text class="section-title">餐次分析</text>
    </view>
    <view class="meal-list">
      <view class="meal-card" wx:for="{{mealTypeStats}}" wx:key="name">
        <text class="meal-name">{{item.name}}</text>
        <view class="meal-stats">
          <view class="meal-stat">
            <text class="stat-value">{{item.count}}</text>
            <text class="stat-label">订单</text>
          </view>
          <view class="meal-stat">
            <text class="stat-value">¥{{item.revenue.toFixed(2)}}</text>
            <text class="stat-label">营收</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 菜品销售排行 -->
  <view class="dish-section">
    <view class="section-header">
      <text class="section-title">菜品销售排行</text>
    </view>
    <view class="dish-list">
      <view class="dish-header">
        <text class="header-cell rank">排名</text>
        <text class="header-cell name">菜品</text>
        <text class="header-cell count">销量</text>
        <text class="header-cell revenue">营收</text>
      </view>
      
      <block wx:if="{{dishStats.length > 0}}">
        <view class="dish-item" wx:for="{{dishStats}}" wx:key="name">
          <text class="item-cell rank {{index < 3 ? 'top' : ''}}">{{index + 1}}</text>
          <text class="item-cell name">{{item.name}}</text>
          <text class="item-cell count">{{item.count}}</text>
          <text class="item-cell revenue">¥{{item.revenue.toFixed(2)}}</text>
        </view>
      </block>
      <view class="empty-state" wx:else>
        <text class="empty-text">暂无数据</text>
      </view>
    </view>
  </view>
</view>
