<view class="login-container">
  <view class="login-box">
    <view class="logo-section">
      <image class="logo" src="/images/school-logo.jpg" mode="aspectFit"></image>
      <text class="title">学校管理后台</text>
      <text class="subtitle">School Admin System</text>
    </view>
    
    <view class="form-section">
      <view class="input-group">
        <view class="input-icon">
          <text class="icon">👤</text>
        </view>
        <input 
          class="input" 
          type="text" 
          placeholder="请输入管理员账号" 
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>
      
      <view class="input-group">
        <view class="input-icon">
          <text class="icon">🔒</text>
        </view>
        <input 
          class="input" 
          type="password" 
          placeholder="请输入密码" 
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>
      
      <button 
        class="login-btn {{isLoading ? 'loading' : ''}}" 
        bindtap="onLogin"
        disabled="{{isLoading}}"
      >
        <text wx:if="{{!isLoading}}">登 录</text>
        <text wx:else>登录中...</text>
      </button>
      
      <view class="tips">
        <text class="tip-text">默认账号: admin</text>
        <text class="tip-text">默认密码: admin123</text>
      </view>
    </view>
  </view>
</view>
