<view class="container">
  <!-- 返回按钮 -->
  <view class="back-bar">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
      <text class="back-text">返回联盟首页</text>
    </view>
  </view>

  <!-- 学校头部 -->
  <view class="school-header">
    <view class="header-bg"></view>
    <view class="header-content">
      <image class="school-logo" src="/images/new-school-logo.jpg" mode="aspectFit"/>
      <view class="school-title-wrapper">
        <text class="school-name">广东北江中学</text>
        <text class="school-en">Guangdong Beijiang Middle School</text>
        <view class="school-tags">
          <text class="tag">国家级示范高中</text>
          <text class="tag">省重点中学</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="section-card quick-section">
    <view class="section-header">
      <text class="section-title">学校系统</text>
    </view>
    <view class="quick-grid">
      <view class="quick-item" bindtap="navigateTo" data-url="/pages/honors/honors">
        <view class="quick-icon-wrapper" style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%)">
          <text class="quick-icon">🏆</text>
        </view>
        <text class="quick-name">荣誉榜</text>
      </view>
      <view class="quick-item" bindtap="navigateTo" data-url="/pages/library/entry/entry">
        <view class="quick-icon-wrapper" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%)">
          <text class="quick-icon">📖</text>
        </view>
        <text class="quick-name">图书馆</text>
      </view>
      <view class="quick-item" bindtap="navigateTo" data-url="/pages/canteen/index/index">
        <view class="quick-icon-wrapper" style="background: linear-gradient(135deg, #FF9800 0%, #FF5722 100%)">
          <text class="quick-icon">🍽️</text>
        </view>
        <text class="quick-name">饭堂点餐</text>
      </view>
      <view class="quick-item" bindtap="navigateTo" data-url="/pages/finance/login/login">
        <view class="quick-icon-wrapper" style="background: linear-gradient(135deg, #4caf50 0%, #2e7d32 100%)">
          <text class="quick-icon">💰</text>
        </view>
        <text class="quick-name">财务系统</text>
      </view>
      <view class="quick-item" bindtap="navigateTo" data-url="/pages/teacher/index/index">
        <view class="quick-icon-wrapper" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%)">
          <text class="quick-icon">👨‍🏫</text>
        </view>
        <text class="quick-name">教师系统</text>
      </view>
      <view class="quick-item" bindtap="navigateTo" data-url="/pages/student/index/index">
        <view class="quick-icon-wrapper" style="background: linear-gradient(135deg, #1abc9c 0%, #16a085 100%)">
          <text class="quick-icon">👨‍🎓</text>
        </view>
        <text class="quick-name">学生系统</text>
      </view>
      <view class="quick-item" bindtap="navigateTo" data-url="/pages/joint-exam/index/index">
        <view class="quick-icon-wrapper" style="background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%)">
          <text class="quick-icon">📝</text>
        </view>
        <text class="quick-name">联考管理</text>
      </view>
      <view class="quick-item" bindtap="navigateTo" data-url="/pages/school-admin/login/login">
        <view class="quick-icon-wrapper" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%)">
          <text class="quick-icon">⚙️</text>
        </view>
        <text class="quick-name">学校管理</text>
      </view>
    </view>
  </view>

  <!-- 学校简介 -->
  <view class="section-card intro-section">
    <view class="section-header">
      <text class="section-title">学校简介</text>
    </view>
    <view class="intro-content">
      <text class="intro-text">广东北江中学是一所位于广东省韶关市的全日制公立高级中学，创建于1939年，是广东省首批国家级示范性普通高中。学校秉承"厚德博学、求实创新"的校训，致力于培养德智体美劳全面发展的社会主义建设者和接班人。</text>
    </view>
  </view>

  <!-- 校园风光 -->
  <view class="section-card campus-section">
    <view class="section-header">
      <text class="section-title">校园风光</text>
      <text class="section-more" bindtap="viewMoreCampus">更多 ></text>
    </view>
    <view class="campus-grid">
      <view class="campus-item" wx:for="{{campusImages}}" wx:key="id">
        <view class="campus-image-placeholder">
          <text class="placeholder-icon">🖼️</text>
          <text class="placeholder-text">{{item.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 办学特色 -->
  <view class="section-card features-section">
    <view class="section-header">
      <text class="section-title">办学特色</text>
    </view>
    <view class="features-grid">
      <view class="feature-card" wx:for="{{features}}" wx:key="id">
        <view class="feature-icon-wrapper" style="background: {{item.color}}15">
          <text class="feature-icon">{{item.icon}}</text>
        </view>
        <text class="feature-title">{{item.title}}</text>
        <text class="feature-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 最新动态 -->
  <view class="section-card news-section">
    <view class="section-header">
      <text class="section-title">最新动态</text>
      <text class="section-more" bindtap="viewMoreNews">更多 ></text>
    </view>
    <view class="news-list">
      <view class="news-item" wx:for="{{newsList}}" wx:key="id" bindtap="onNewsTap" data-id="{{item.id}}">
        <view class="news-badge" wx:if="{{item.isNew}}">NEW</view>
        <view class="news-content">
          <text class="news-title">{{item.title}}</text>
          <text class="news-date">{{item.date}}</text>
        </view>
        <text class="news-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 底部联系信息 -->
  <view class="footer-section">
    <view class="footer-content">
      <view class="footer-info">
        <view class="footer-item">
          <text class="footer-icon">📍</text>
          <text class="footer-text">广东省韶关市武江区惠民北路</text>
        </view>
        <view class="footer-item">
          <text class="footer-icon">📞</text>
          <text class="footer-text">19388112925</text>
        </view>
        <view class="footer-item">
          <text class="footer-icon">✉️</text>
          <text class="footer-text">gdbeijiang@edu.cn</text>
        </view>
      </view>
      <view class="footer-divider"></view>
      <text class="copyright">© 2026 广东北江中学何逸 版权所有</text>
    </view>
  </view>
</view>
