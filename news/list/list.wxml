<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="header-title">学校新闻</text>
    <view class="placeholder"></view>
  </view>

  <!-- 新闻列表 -->
  <view class="news-list">
    <view 
      class="news-card" 
      wx:for="{{newsList}}" 
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onNewsTap"
    >
      <image 
        class="news-cover" 
        src="{{item.cover_image || '/images/default-news.png'}}" 
        mode="aspectFill"
      />
      <view class="news-content">
        <text class="news-title">{{item.title}}</text>
        <text class="news-summary">{{item.summary}}</text>
        <view class="news-footer">
          <text class="news-date">{{item.published_at || item.created_at}}</text>
          <view class="news-views">
            <text class="view-icon">👁</text>
            <text class="view-count">{{item.view_count || 0}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{newsList.length === 0 && !loading}}">
    <text class="empty-icon">📰</text>
    <text class="empty-text">暂无新闻</text>
  </view>

  <!-- 加载状态 -->
  <view class="load-more" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>
  <view class="load-more" wx:if="{{!hasMore && newsList.length > 0}}">
    <text class="no-more-text">没有更多新闻了</text>
  </view>
</view>
