.container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 顶部标题栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 36rpx;
  color: #fff;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.placeholder {
  width: 60rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx;
}

.loading-text {
  font-size: 32rpx;
  color: #999;
}

/* 新闻内容 */
.news-content {
  background: #fff;
}

.news-cover {
  width: 100%;
  height: 400rpx;
  background: #f0f0f0;
}

.news-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.news-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.news-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
}

.news-author {
  font-size: 28rpx;
  color: #667eea;
}

.news-date {
  font-size: 26rpx;
  color: #999;
}

.news-views {
  display: flex;
  align-items: center;
}

.view-icon {
  font-size: 26rpx;
  margin-right: 6rpx;
}

.view-count {
  font-size: 26rpx;
  color: #999;
}

.news-body {
  padding: 30rpx;
  font-size: 32rpx;
  color: #333;
  line-height: 1.8;
}
